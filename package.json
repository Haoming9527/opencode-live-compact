{
  "name": "opencode-live-compact",
  "version": "0.1.1",
  "description": "Deterministic incremental context compaction for OpenCode V2",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "live-compact",
    "context-compaction",
    "context-management",
    "prompt-caching",
    "coding-agent",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haoming9527/opencode-live-compact.git"
  },
  "homepage": "https://github.com/Haoming9527/opencode-live-compact#readme",
  "bugs": {
    "url": "https://github.com/Haoming9527/opencode-live-compact/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "docs/architecture.md",
    "docs/assets/benchmarks-en.svg",
    "docs/assets/benchmarks-zh-CN.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.ts\"",
    "test:integration": "npm run build && node --test tests/plugin.integration.ts",
    "benchmark": "node benchmarks/run.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6"
  },
  "devDependencies": {
    "@opencode/client": "2.2.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
